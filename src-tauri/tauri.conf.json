{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notera",
  "version": "1.0.0",
  "identifier": "com.kingenonso.notera",
  "build": {
    "beforeBuildCommand": "npm run prepare-web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Notera",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Visual boards for notes, pictures, videos and plans",
    "longDescription": "Notera is a free visual board app. Boards hold notes, checklists, links, pictures, videos and voice notes, and boards can hold other boards. Everything is saved on your own computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
